{
  "schema": "bedrock-dynamic-sdk/stage-b/binding-registry/1",
  "apiVersion": "1.0.0",
  "packageName": "@bedrock/sdk",
  "vanillaPackageName": "@bedrock/vanilla-data",
  "description": "Machine-readable Stage B/C binding surface. Stage C generates @bedrock/sdk (.d.ts, index.js, package.json) and @bedrock/sdk-bootstrapheader from this registry (DESIGN.md §11).",
  "naming": {
    "case": "camelCase",
    "getter": "C++ accessor -> JS property",
    "result": "Result<T> -> value or throws Error{code,message}",
    "optional": "std::optional<T> -> T | undefined",
    "event": "EventSignal += -> {remove()}",
    "units": "seconds in JS, ticks in C++ (x20; Infinity preserved)",
    "ids": "minecraft:..."
  },
  "unitConversion": {
    "time": {
      "jsUnit": "seconds",
      "cppUnit": "ticks",
      "ticksPerSecond": 20,
      "infinityPreserved": true,
      "appliesTo": ["player.addEffect.durationSeconds", "Effect.duration", "Arg.duration"]
    }
  },
  "exports": [
    { "name": "Mod", "kind": "value", "cpp": "bedrock::sdk::Mod", "tsType": "typeof Mod", "note": "base class; default export class is constructed with no arguments" },
    { "name": "Arg", "kind": "value", "cpp": "CommandBridge", "tsType": "ArgFactory", "note": "effect/duration/int/bool/string/message/float builders" },
    { "name": "Setting", "kind": "value", "cpp": "bedrock::sdk::Setting", "tsType": "SettingFactory", "note": "toggle/slider/choice/text control descriptors" },
    { "name": "ItemStack", "kind": "value", "cpp": "bedrock::sdk::ItemStack", "tsType": "typeof ItemStack", "note": "constructor new ItemStack(typeId, amount=1); getters typeId, amount" },
    { "name": "EquipmentSlot", "kind": "value", "cpp": "bedrock::sdk::EquipmentSlot", "tsType": "typeof EquipmentSlot", "note": "MainHand/Offhand/Head/Chest/Legs/Feet constants" },
    { "name": "brightness", "kind": "value", "cpp": "bedrock::sdk::BrightnessOverride", "tsType": "BrightnessOverride", "note": "setGamma(gamma | undefined) with last-writer-wins and automatic restore on unload" },
    { "name": "world", "kind": "value", "cpp": "bedrock::sdk::World", "tsType": "World", "note": "realm-bound singleton" },
    { "name": "system", "kind": "value", "cpp": "bedrock::sdk::System", "tsType": "System", "note": "realm-bound singleton" },
    { "name": "files", "kind": "value", "cpp": "stageb::SdkBindings files surface", "tsType": "Files", "note": "per-Mod synchronous file API rooted at <ScriptClient.dll dir>/mod-data/<ModName>; paths are relative and sandboxed" },
    { "name": "CommandContext", "kind": "type", "cpp": "CommandBridge::Context", "note": "get<T>/getOptional<T>/rawLine/respond" },
    { "name": "CommandBuilder", "kind": "type", "cpp": "CommandBridge::Builder", "note": "literal/argument/executes chain builder" },
    { "name": "CommandManager", "kind": "type", "cpp": "CommandBridge::Registry", "note": "register/unregister mod-scoped commands" },
    { "name": "World", "kind": "type", "cpp": "bedrock::sdk::World", "note": "client world surface" },
    { "name": "System", "kind": "type", "cpp": "bedrock::sdk::System", "note": "tick scheduler surface" },
    { "name": "Player", "kind": "type", "cpp": "bedrock::sdk::Player", "note": "client player entity wrapper" },
    { "name": "Entity", "kind": "type", "cpp": "bedrock::sdk::Entity", "note": "client actor entity wrapper" },
    { "name": "Dimension", "kind": "type", "cpp": "bedrock::sdk::Dimension", "note": "client dimension wrapper" },
    { "name": "Block", "kind": "type", "cpp": "bedrock::sdk::Block", "note": "client block snapshot and mutation wrapper" },
    { "name": "Effect", "kind": "type", "cpp": "bedrock::sdk::Effect", "note": "active potion effect (duration in seconds)" },
    { "name": "EffectOptions", "kind": "type", "cpp": "bedrock::sdk::EffectOptions", "note": "amplifier (0..255) and showParticles options" },
    { "name": "Vector3", "kind": "type", "cpp": "bedrock::sdk::Vector3", "note": "{x, y, z} floating-point coordinates" },
    { "name": "BlockPosition", "kind": "type", "cpp": "bedrock::sdk::BlockPosition", "note": "{x, y, z} integer block coordinates" },
    { "name": "Rotation", "kind": "type", "cpp": "bedrock::sdk::Rotation", "note": "{x, y} pitch and yaw in degrees" },
    { "name": "DynamicProperty", "kind": "type", "cpp": "bedrock::sdk::DynamicProperty", "note": "boolean | number | string | Vector3" },
    { "name": "Subscription", "kind": "type", "cpp": "bedrock::sdk::Subscription", "note": "{ remove(): void } subscription handle" },
    { "name": "EventSignal", "kind": "type", "cpp": "bedrock::sdk::EventSignal", "note": "subscribe(handler) -> Subscription" },
    { "name": "PlayerSpawnAfterEvent", "kind": "type", "cpp": "bedrock::sdk::Mod::onPlayerSpawn", "note": "{ player: Player, initialSpawn: boolean }" },
    { "name": "WorldAfterEvents", "kind": "type", "cpp": "bedrock::sdk::World", "note": "world.afterEvents catalog" },
    { "name": "SettingsPage", "kind": "type", "cpp": "bedrock::sdk::SettingsPage", "note": "declarative OreUI Mod Menu settings page builder" },
    { "name": "SettingDescriptor", "kind": "type", "cpp": "bedrock::sdk::Setting", "note": "toggle/slider/choice/text setting descriptor" },
    { "name": "SettingValue", "kind": "type", "cpp": "bedrock::sdk::SettingValue", "note": "boolean | number | string" },
    { "name": "KeyBindings", "kind": "type", "cpp": "bedrock::sdk::KeyBindings", "note": "mod-scoped keybind registry and changed event" },
    { "name": "KeybindEvent", "kind": "type", "cpp": "bedrock::sdk::KeybindEvent", "note": "{ id: string, pressed: boolean }" },
    { "name": "BrightnessOverride", "kind": "type", "cpp": "bedrock::sdk::BrightnessOverride", "note": "client brightness gamma override" },
    { "name": "ErrorCode", "kind": "type", "cpp": "bedrock::sdk::ErrorCode", "note": "SDK error code string literal union" },
    { "name": "SdkError", "kind": "type", "cpp": "bedrock::sdk::Error", "note": "Error with code: ErrorCode" },
    { "name": "HealthComponent", "kind": "type", "cpp": "bedrock::sdk::HealthComponent", "note": "minecraft:health read-only component" },
    { "name": "FoodComponent", "kind": "type", "cpp": "bedrock::sdk::FoodComponent", "note": "minecraft:food read-only component" },
    { "name": "MovementComponent", "kind": "type", "cpp": "bedrock::sdk::MovementComponent", "note": "minecraft:movement read-only component" },
    { "name": "InventoryComponent", "kind": "type", "cpp": "bedrock::sdk::InventoryComponent", "note": "minecraft:inventory read-only snapshot component" },
    { "name": "EquippableComponent", "kind": "type", "cpp": "bedrock::sdk::EquippableComponent", "note": "minecraft:equippable read-only snapshot component" },
    { "name": "ItemEntityComponent", "kind": "type", "cpp": "bedrock::sdk::Entity::getItemStack", "note": "minecraft:item dropped stack component" },
    { "name": "EntityComponentMap", "kind": "type", "cpp": "bedrock::sdk::Entity::getComponent", "note": "componentId -> component type map" },
    { "name": "Files", "kind": "type", "cpp": "stageb::SdkBindings files surface", "note": "synchronous, throwing file operations on this mod's persistent data root" },
    { "name": "FileStat", "kind": "type", "cpp": "std::filesystem::file_status", "note": "{ size, directory, modifiedMs } (epoch milliseconds)" },
    { "name": "FileEntry", "kind": "type", "cpp": "std::filesystem::directory_entry", "note": "{ name, directory }" },
    { "name": "RemoveOptions", "kind": "type", "cpp": "stageb::SdkBindings files surface", "note": "{ recursive?: boolean }; directories require recursive: true" }
  ],
  "members": [
    { "path": "world.localPlayer", "cpp": "World::localPlayer", "js": "method", "params": [], "result": "Player | undefined", "bound": true },
    { "path": "world.getAllPlayers", "cpp": "World::getAllPlayers", "js": "method", "params": [], "result": "Player[]", "bound": true },
    { "path": "world.getPlayers", "cpp": "World::getPlayers", "js": "method", "params": [], "result": "Player[]", "bound": true },
    { "path": "world.getDimension", "cpp": "World::getDimension", "js": "method", "params": [{ "name": "typeId", "type": "string" }], "result": "Dimension | undefined", "bound": true, "note": "resolves only when typeId matches active client dimension" },
    { "path": "world.currentDimension", "cpp": "World::currentDimension", "js": "getter", "result": "Dimension | undefined", "bound": true },
    { "path": "world.sendMessage", "cpp": "World::sendMessage", "js": "method", "params": [{ "name": "text", "type": "string" }], "result": "void", "bound": true },
    { "path": "world.getDynamicProperty", "cpp": "World::getDynamicProperty", "js": "method", "params": [{ "name": "key", "type": "string" }], "result": "DynamicProperty | undefined", "bound": true, "note": "Mod-scoped in-memory store per world session" },
    { "path": "world.setDynamicProperty", "cpp": "World::setDynamicProperty", "js": "method", "params": [{ "name": "key", "type": "string" }, { "name": "value", "type": "DynamicProperty | null | undefined", "optional": true }], "result": "void", "bound": true, "note": "undefined/null removes key" },
    { "path": "world.afterEvents.playerSpawn", "cpp": "Mod::onPlayerSpawn", "js": "event", "eventType": "PlayerSpawnAfterEvent", "result": "Subscription", "bound": true, "note": "subscribe(fn) delivers {player, initialSpawn} and returns {remove()}" },
    { "path": "system.run", "cpp": "System::run", "js": "method", "params": [{ "name": "task", "type": "() => void" }], "result": "TaskId", "bound": true },
    { "path": "system.runTimeout", "cpp": "System::runTimeout", "js": "method", "params": [{ "name": "task", "type": "() => void" }, { "name": "ticks", "type": "number" }], "result": "TaskId", "bound": true },
    { "path": "system.runInterval", "cpp": "System::runInterval", "js": "method", "params": [{ "name": "task", "type": "() => void" }, { "name": "ticks", "type": "number" }], "result": "TaskId", "bound": true },
    { "path": "system.clearRun", "cpp": "System::clearRun", "js": "method", "params": [{ "name": "id", "type": "TaskId" }], "result": "boolean", "bound": true },
    { "path": "files.dataDir", "cpp": "SdkBindings::filesDataDir", "js": "getter", "result": "string", "bound": true, "note": "absolute path of this mod's data root; created lazily on first use" },
    { "path": "files.readText", "cpp": "SdkBindings::filesReadText", "js": "method", "params": [{ "name": "path", "type": "string" }], "result": "string", "bound": true },
    { "path": "files.writeText", "cpp": "SdkBindings::filesWriteText", "js": "method", "params": [{ "name": "path", "type": "string" }, { "name": "text", "type": "string" }], "result": "void", "bound": true, "note": "creates parent directories; UTF-8 text" },
    { "path": "files.appendText", "cpp": "SdkBindings::filesAppendText", "js": "method", "params": [{ "name": "path", "type": "string" }, { "name": "text", "type": "string" }], "result": "void", "bound": true },
    { "path": "files.readBytes", "cpp": "SdkBindings::filesReadBytes", "js": "method", "params": [{ "name": "path", "type": "string" }], "result": "Uint8Array", "bound": true },
    { "path": "files.writeBytes", "cpp": "SdkBindings::filesWriteBytes", "js": "method", "params": [{ "name": "path", "type": "string" }, { "name": "bytes", "type": "Uint8Array" }], "result": "void", "bound": true, "note": "creates parent directories" },
    { "path": "files.readJson", "cpp": "JSON.parse(files.readText)", "js": "method", "params": [{ "name": "path", "type": "string" }], "result": "unknown", "bound": true },
    { "path": "files.writeJson", "cpp": "JSON.stringify + files.writeText", "js": "method", "params": [{ "name": "path", "type": "string" }, { "name": "value", "type": "unknown" }], "result": "void", "bound": true },
    { "path": "files.exists", "cpp": "SdkBindings::filesExists", "js": "method", "params": [{ "name": "path", "type": "string" }], "result": "boolean", "bound": true },
    { "path": "files.stat", "cpp": "SdkBindings::filesStat", "js": "method", "params": [{ "name": "path", "type": "string" }], "result": "FileStat", "bound": true },
    { "path": "files.list", "cpp": "SdkBindings::filesList", "js": "method", "params": [{ "name": "path", "type": "string", "optional": true }], "result": "FileEntry[]", "bound": true, "note": "defaults to '.'" },
    { "path": "files.mkdir", "cpp": "SdkBindings::filesMkdir", "js": "method", "params": [{ "name": "path", "type": "string" }], "result": "void", "bound": true, "note": "recursive" },
    { "path": "files.remove", "cpp": "SdkBindings::filesRemove", "js": "method", "params": [{ "name": "path", "type": "string" }, { "name": "options", "type": "RemoveOptions", "optional": true }], "result": "void", "bound": true, "note": "file, or directory with { recursive: true }" },
    { "path": "files.rename", "cpp": "SdkBindings::filesRename", "js": "method", "params": [{ "name": "from", "type": "string" }, { "name": "to", "type": "string" }], "result": "void", "bound": true },
    { "path": "player.name", "cpp": "Player::name", "js": "getter", "result": "string | undefined", "bound": true },
    { "path": "player.location", "cpp": "Entity::location", "js": "getter", "result": "Vector3 | undefined", "bound": true },
    { "path": "player.rotation", "cpp": "Entity::getRotation", "js": "getter", "result": "Rotation | undefined", "bound": true },
    { "path": "player.dimension", "cpp": "Entity::dimension", "js": "getter", "result": "Dimension | undefined", "bound": true },
    { "path": "player.sendMessage", "cpp": "Player::sendMessage", "js": "method", "params": [{ "name": "text", "type": "string" }], "result": "void", "bound": true },
    { "path": "player.teleport", "cpp": "Entity::teleport", "js": "method", "params": [{ "name": "position", "type": "Vector3" }], "result": "void", "bound": true, "note": "Stage A native throws Error{code:'Unavailable'} on client" },
    { "path": "player.addTag", "cpp": "Entity::addTag", "js": "method", "params": [{ "name": "tag", "type": "string" }], "result": "boolean", "bound": true, "note": "Stage A native throws Error{code:'Unavailable'} on client" },
    { "path": "player.getComponent", "cpp": "Entity::getComponent<T>", "js": "method", "params": [{ "name": "componentId", "type": "string" }], "result": "EntityComponent | undefined", "bound": true, "note": "supports minecraft:health, minecraft:food, minecraft:movement, minecraft:inventory, minecraft:equippable, minecraft:item" },
    { "path": "player.addEffect", "cpp": "Player::addEffect", "js": "method", "params": [{ "name": "typeId", "type": "string" }, { "name": "durationSeconds", "type": "number", "unit": "seconds" }, { "name": "options", "type": "EffectOptions", "optional": true }], "result": "void", "bound": true, "note": "duration is seconds (host converts x20 to ticks); Infinity -> +inf" },
    { "path": "player.removeEffect", "cpp": "Player::removeEffect", "js": "method", "params": [{ "name": "typeId", "type": "string" }], "result": "boolean", "bound": true },
    { "path": "player.clearEffects", "cpp": "Player::clearEffects", "js": "method", "params": [], "result": "void", "bound": true },
    { "path": "player.getEffects", "cpp": "Player::getEffects", "js": "method", "params": [], "result": "Effect[]", "bound": true, "note": "Effect.duration is seconds (host converts ticks / 20)" },
    { "path": "entity.id", "cpp": "Entity::id_", "js": "getter", "result": "string", "bound": true },
    { "path": "entity.typeId", "cpp": "Entity::typeId", "js": "getter", "result": "string | undefined", "bound": true },
    { "path": "entity.isValid", "cpp": "Entity::isValid", "js": "getter", "result": "boolean", "bound": true },
    { "path": "entity.location", "cpp": "Entity::location", "js": "getter", "result": "Vector3 | undefined", "bound": true },
    { "path": "entity.rotation", "cpp": "Entity::getRotation", "js": "getter", "result": "Rotation | undefined", "bound": true },
    { "path": "entity.getRotation", "cpp": "Entity::getRotation", "js": "method", "params": [], "result": "Rotation | undefined", "bound": true },
    { "path": "entity.dimension", "cpp": "Entity::dimension", "js": "getter", "result": "Dimension | undefined", "bound": true },
    { "path": "entity.getItemStack", "cpp": "Entity::getItemStack", "js": "method", "params": [], "result": "ItemStack | undefined", "bound": true, "note": "item-entity-detection for minecraft:item actors" },
    { "path": "entity.teleport", "cpp": "Entity::teleport", "js": "method", "params": [{ "name": "position", "type": "Vector3" }], "result": "void", "bound": true, "note": "Stage A native throws Error{code:'Unavailable'} on client" },
    { "path": "entity.addTag", "cpp": "Entity::addTag", "js": "method", "params": [{ "name": "tag", "type": "string" }], "result": "boolean", "bound": true, "note": "Stage A native throws Error{code:'Unavailable'} on client" },
    { "path": "entity.getComponent", "cpp": "Entity::getComponent<T>", "js": "method", "params": [{ "name": "componentId", "type": "string" }], "result": "EntityComponent | undefined", "bound": true, "note": "supports minecraft:health, minecraft:food, minecraft:movement, minecraft:inventory, minecraft:equippable, minecraft:item" },
    { "path": "entity.getDynamicProperty", "cpp": "Entity::getDynamicProperty", "js": "method", "params": [{ "name": "key", "type": "string" }], "result": "DynamicProperty | undefined", "bound": true },
    { "path": "entity.setDynamicProperty", "cpp": "Entity::setDynamicProperty", "js": "method", "params": [{ "name": "key", "type": "string" }, { "name": "value", "type": "DynamicProperty | null | undefined", "optional": true }], "result": "void", "bound": true },
    { "path": "dimension.id", "cpp": "Dimension::typeId", "js": "getter", "result": "string", "bound": true },
    { "path": "dimension.typeId", "cpp": "Dimension::typeId", "js": "getter", "result": "string", "bound": true },
    { "path": "dimension.getBlock", "cpp": "Dimension::getBlock", "js": "method", "params": [{ "name": "position", "type": "BlockPosition" }], "result": "Block | undefined", "bound": true },
    { "path": "dimension.getEntities", "cpp": "Dimension::getEntities", "js": "method", "params": [], "result": "Entity[]", "bound": true },
    { "path": "dimension.spawnEntity", "cpp": "Dimension::spawnEntity", "js": "method", "params": [{ "name": "typeId", "type": "string" }, { "name": "position", "type": "Vector3" }], "result": "Entity", "bound": true, "note": "Stage A native throws Error{code:'Unavailable'} on client" },
    { "path": "block.typeId", "cpp": "Block::typeId", "js": "getter", "result": "string", "bound": true },
    { "path": "block.location", "cpp": "Block::location", "js": "getter", "result": "BlockPosition", "bound": true },
    { "path": "block.setType", "cpp": "Block::setType", "js": "method", "params": [{ "name": "typeId", "type": "string" }], "result": "void", "bound": true },
    { "path": "new ItemStack", "cpp": "ItemStack", "js": "constructor", "params": [{ "name": "typeId", "type": "string" }, { "name": "amount", "type": "number", "optional": true }], "result": "ItemStack", "bound": true, "note": "Exposes readonly typeId and amount only (see unsupportedLimitations)" },
    { "path": "Mod.commands.register", "cpp": "CommandBridge", "js": "method", "params": [{ "name": "name", "type": "string" }, { "name": "builder", "type": "(cmd: CommandBuilder) => void" }], "result": "void", "bound": true },
    { "path": "Mod.commands.unregister", "cpp": "CommandBridge", "js": "method", "params": [{ "name": "name", "type": "string" }], "result": "void", "bound": true },
    { "path": "Mod.settings", "cpp": "SettingsPage", "js": "builder", "params": [{ "name": "titleKey", "type": "string" }], "result": "SettingsPage", "bound": true, "note": "translates to bedrock::sdk::SettingsPage (add/locale/onChange/modName/registerPage/unregisterPage/value)" },
    { "path": "Mod.keybinds", "cpp": "KeyBindings", "js": "object", "result": "KeyBindings", "bound": true, "note": "translates to bedrock::sdk::KeyBindings (add/locale/key/changed.subscribe)" },
    { "path": "brightness.setGamma", "cpp": "BrightnessOverride::setGamma", "js": "method", "params": [{ "name": "gamma", "type": "number | undefined", "optional": true }], "result": "void", "bound": true, "note": "translates to bedrock::sdk::BrightnessOverride::setGamma with last-writer-wins and restore on unload" }
  ],
  "unsupportedLimitations": [
    {
      "feature": "ItemStack extra metadata (nameTag, lore, enchants, durability, dynamicProperties)",
      "reason": "Stage A bedrock::sdk::ItemStack only exposes typeId() and amount() (sdk/include/bedrock/sdk/game_types.hpp)."
    },
    {
      "feature": "Container mutation (InventoryComponent::setItem / addItem)",
      "reason": "Stage A bedrock::sdk::InventoryComponent is a read-only snapshot (size() and getItem(slot) only)."
    },
    {
      "feature": "EquippableComponent mutation (setEquipment)",
      "reason": "Stage A bedrock::sdk::EquippableComponent is a read-only snapshot (getEquipment(slot) only)."
    },
    {
      "feature": "Client-side spawnEntity / general teleport / entity tags",
      "reason": "Stage A GameFrame returns ErrorCode::Unavailable on client builds; JS bindings surface this as Error{code:'Unavailable'} without faking success."
    }
  ],
  "errorCodes": ["Invalid", "AlreadyRegistered", "NotFound", "WrongType", "Storage", "Unavailable", "BufferTooSmall", "Internal"],
  "builtinModules": ["@bedrock/sdk", "@bedrock/vanilla-data"],
  "commandArgs": ["effect", "duration", "int", "bool", "string", "message", "float"]
}
